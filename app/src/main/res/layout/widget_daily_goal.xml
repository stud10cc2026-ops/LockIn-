<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_daily_goal_dark"
    android:paddingTop="12dp"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingBottom="10dp">

    <!-- Active Goal State -->
    <LinearLayout
        android:id="@+id/widget_active_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Row: Lock In (left) | Goal Name (right) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Lock In"
                android:textColor="#9EA5B0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:alpha="0.8" />

            <TextView
                android:id="@+id/widget_goal_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Daily Goal"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />
        </RelativeLayout>

        <!-- Center: Dynamic Dotted Progress Grid -->
        <ImageView
            android:id="@+id/widget_dot_grid"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_daily_goal_name"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="0dp" />

        <!-- Bottom Row: Day on left, remaining days on right -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/widget_day_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="DAY 08"
                android:textColor="#8A92A0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/widget_remaining_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="22 DAYS LEFT"
                android:textColor="#8A92A0"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Empty State (when no goal is active) -->
    <LinearLayout
        android:id="@+id/widget_empty_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SET A DAILY GOAL"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/widget_empty_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to choose your duration"
            android:textColor="#8A92A0"
            android:textSize="11sp"
            android:layout_marginTop="3dp" />
    </LinearLayout>
</LinearLayout>
